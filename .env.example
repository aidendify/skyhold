PORT=8080
DATABASE_PATH=/data/skyhold.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
BUSINESS_PHONE=
PUBLIC_BASE_URL=http://localhost:8080

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset to copy link / blurbs without sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional Twilio SMS. Leave unset; product works via Copy link alone.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional OpenWeather suggestion banner (never auto-holds).
# OPENWEATHER_API_KEY=
# Or: WEATHER_API_KEY=
# WEATHER_LAT=
# WEATHER_LON=
# WEATHER_PRECIP_THRESHOLD=50
# WEATHER_WIND_THRESHOLD=

# Optional footer link labeled "Powered by SkyHold". Leave empty for no footer.
MARKETING_URL=
